# 🔧 Variables de Entorno - Gestor de Tareas con Redis

# URL de conexión a Redis (RedisCloud o local)
# Formato: redis://[:password@]host:port[/db]
# Ejemplo local: redis://localhost:6379
# Ejemplo RedisCloud: redis://default:abc123xyz@redis-12345.c123.us-east-1-2.ec2.rediscloud.com:12345
REDIS_URL=redis://localhost:6379

# Secreto para firmar JWT (cambia esto en producción a algo muy seguro)
# Debe ser una cadena aleatoria larga y segura
JWT_SECRET=tu_secreto_super_seguro_cambiar_en_produccion_con_random_string

# Puerto del servidor Node.js
PORT=3000

# Ambiente (development, staging, production)
NODE_ENV=development
